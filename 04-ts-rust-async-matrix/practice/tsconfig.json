{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "types": [
            "node"
        ],
        "verbatimModuleSyntax": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ]
}